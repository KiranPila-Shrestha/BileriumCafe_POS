@page "/checkoutpage"
 @inject CustomerService CustomerService 
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject OrderItemService OrderItemServices
@inject OrderService OrderService

@if (_step == 1)
{
    <MudText Typo="Typo.h6">Enter Customer Phone Number to check details</MudText>
     <div style="width:400px;" class="mt-5">
        <MudTextField @bind-Value="_customerPhoneNum" Label="Customer Phone Number" Variant="Variant.Outlined" Class="mb-5" Margin="Margin.Dense"></MudTextField>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="my-3">@_errorMessage</MudAlert>
    }


    <MudButton Variant="Variant.Outlined" DisableElevation="true" Color="Color.Primary" @onclick="@(() => NavigationManager.NavigateTo("/Order-in-items"))" Class="mr-5">Go Back</MudButton>

    <MudButton Variant="Variant.Filled" DisableElevation="true" Color="Color.Secondary" @onclick="handleCheckMembership">Check Membership</MudButton>
}

@if (_step == 2)
{
    <div style="padding-left:10px">
        <MudText Typo="Typo.h4">Enter Customer Details</MudText>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3 mb-5">@_errorMessage</MudAlert>
    }


    <div style="width:400px;" class="mt-5">
        <MudTextField @bind-Value="_customer.CustomerPhoneNum" Label="Customer Phone Number" Variant="Variant.Outlined" Class="mb-5" Margin="Margin.Dense"></MudTextField>
        <MudTextField @bind-Value="_customer.CustomerName" Label="Customer Name" Variant="Variant.Outlined" Class="mb-5" Margin="Margin.Dense"></MudTextField>
        <MudTextField @bind-Value="_customer.CustomerAddress" Label="Customer Address" Variant="Variant.Outlined" Class="mb-5" Margin="Margin.Dense"></MudTextField>
    </div>

    <MudButton Variant="Variant.Outlined" DisableElevation="true" Color="Color.Primary" @onclick="@(() => _step--)" Class="mr-5">Go Back</MudButton>
    <MudButton Variant="Variant.Filled" DisableElevation="true" Color="Color.Secondary" @onclick="validateUserDetails">Press on</MudButton>
}

@if (_step == 3)
{
    <MudContainer>
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h4" Align="Align.Center">BislerumCafe-Shop Bill</MudText>
                <MudSpacer />
                <MudText Typo="Typo.body1" Align="Align.Center">Date: @DateTime.Now</MudText>
            </MudCardHeader>

            <MudDivider />


            <MudCardContent>
                <MudText Typo="Typo.h6">Customer Details:</MudText>

                <MudGrid Spacing="3">
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.body2">Customer Name: @_customer.CustomerName</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.body2">Phone Number: @_customer.CustomerPhoneNum</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.body2">Address: @_customer.CustomerAddress</MudText>
                    </MudItem>
                </MudGrid>


            </MudCardContent>

            <MudDivider />


            <MudCardContent>
                <MudTable Items="@Elements"
                Hover="@hover"
                Bordered="@bordered"
                Class="border-0 shadow-none">

                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Order Details</MudText>
                        <MudSpacer />
                        <MudSpacer />
                        <MudText Typo="Typo.subtitle1">Final Total: @_totalAmount</MudText>
                    </ToolBarContent>


                    <HeaderContent>
                        <MudTh>Item Name</MudTh>
                        <MudTh>Item Type</MudTh>
                        <MudTh>Price</MudTh>
                        <MudTh>Quantity</MudTh>
                        <MudTh>Total</MudTh>
                    </HeaderContent>


                    <RowTemplate>
                        <MudTd DataLabel="CoffeeType">@context.ItemName</MudTd>
                        <MudTd DataLabel="Item Type">@context.ItemType</MudTd>
                        <MudTd DataLabel="Price">Rs.@context.Price</MudTd>
                        <MudTd DataLabel="Quantity">@context.Quantity </MudTd>
                        <MudTd DataLabel="Price">Rs.@context.TotalPrice</MudTd>
                    </RowTemplate>
                </MudTable>
                <div class="py-5 pl-3">
                    <MudButton Color="Color.Primary" Variant="Variant.Outlined" Class="mr-5" OnClick="handleGoBackButton">Go Back</MudButton>

                    <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="handleOrderPlace">Place Order</MudButton>
                </div>
                @*                checkkk *@
                <div class="d-flex justify-content-between mt-4">

                    <div class="">
                        <MudText Typo="Typo.h6">Total Free Coffees: @_totalFreeCoffeeCount</MudText>
                        <MudButton Color="Color.Info" Variant="Variant.Filled" Class="mt-2">Reedem</MudButton>
                        @if (_totalFreeCoffeeCount != 0)
                        {
                            <MudText Typo="Typo.h6">Total Free Coffees: @_totalFreeCoffeeCount</MudText>
                            <MudButton Color="Color.Info" Variant="Variant.Filled" Class="mt-2" OnClick="HandleFreeCoffeeRedeemption">Reedem</MudButton>
                        }
                    </div>

                    <div>
                        <MudText Typo="Typo.subtitle1">Total Amount: <b>Rs.@Math.Round(_totalAmount, 2)</b></MudText>
                        <MudText Typo="Typo.subtitle1">Discount Amount: <b>Rs.@Math.Round(_discountAmount, 2)</b></MudText>
                        <MudDivider DividerType="@DividerType.Middle" />
                        <MudText Typo="Typo.subtitle1">Grand Total: <b>Rs.@Math.Round(_totalAmount - _discountAmount, 2)</b></MudText>
                    </div>
                </div>

            </MudCardContent>
        </MudCard>
    </MudContainer>

}


@code {

    [CascadingParameter] private GlobalState _globalState { get; set; }

    private IEnumerable<OrderItemModel> Elements = new List<OrderItemModel>();
    public double _totalAmount { get; set; } = 0;

    //MudTable Configurations
    private bool hover = true;
    private bool bordered = true;


    private string _customerPhoneNum { get; set; }
    private Customer _customer { get; set; }

    private string _errorMessage { set; get; }

    private int _step = 1;
    private bool _customerIsMember { get; set; } = false;

    private int _totalFreeCoffeeCount { get; set; } = 0;
    public double _discountAmount { get; set; } = 0;

    //Validates the customer details that place order
    private void validateUserDetails()
    {
        if (string.IsNullOrEmpty(_customer.CustomerName) || string.IsNullOrEmpty(_customer.CustomerAddress) || string.IsNullOrEmpty(_customer.CustomerPhoneNum))
        {
            _errorMessage = "Please enter all the details.";
            return;
        }
        _errorMessage = "";
        _step++;
    }

    //Checks if customer is already a member.
    private void handleCheckMembership()
    {
        if (string.IsNullOrEmpty(_customerPhoneNum))
        {
            _errorMessage = "Please provide your phone number";
            return;
        }

        _customer = CustomerService.GetCustomerByPhoneNum(_customerPhoneNum);

        if (_customer == null)
        {
            Snackbar.Add("This customer is not currently amember", Severity.Error);
            _customer = new();
            _customer.CustomerPhoneNum = _customerPhoneNum;
            _step++;
            return;
        }

        //get membership benefit for free coffee.
        _totalFreeCoffeeCount = CustomerService.TotalFreeCoffeeCount(_customer.CustomerPhoneNum);
        int countTotalFreeCoffee = CustomerService.TotalFreeCoffeeCount(_customer.CustomerPhoneNum);

        // _totalRemainingFreeCoffeeCount = countTotalFreeCoffee;
        if (countTotalFreeCoffee < 0)
        {
            _totalFreeCoffeeCount = 0;
        }
        else
        {
            _totalFreeCoffeeCount = countTotalFreeCoffee - _customer.RedeemedCoffeeCount;
        }
        bool isCustomerRegularMember = CustomerService.CheckIfCustomerIsReguralMember(_customer.CustomerPhoneNum);

        if (isCustomerRegularMember)
        {
            _discountAmount = _totalAmount * 0.1;
        }

        Snackbar.Add("The Customer is now a member. Successfully.", Severity.Success);

        _customerIsMember = true;
        _step = 3;

    }

    //  Coffee Redeemption handled after every 10 purchase
    private void HandleFreeCoffeeRedeemption()
    {
        OrderItemService orderItemService = new OrderItemService();
        Dictionary<string, double> membershipBenifies = orderItemService.RedeemFreeCoffees(_totalFreeCoffeeCount, _globalState.OrderItems);

        //Converting double to integer
        int redeemedCoffeeCount = (int)membershipBenifies["redeemedCoffeeCount"];
        _discountAmount = membershipBenifies["discount"];

        CustomerService.UpdateRedeemedCoffeeCount(_customer.CustomerPhoneNum, redeemedCoffeeCount);

        Snackbar.Add($"{redeemedCoffeeCount} coffees are redeemed.", Severity.Success);
    }


    protected override void OnInitialized()
    {
        
        Elements = _globalState.OrderItems;
        _totalAmount = OrderItemServices.CalculateTotalAmount(Elements);
    }
    //implemented for handling goback buttons.
    private void handleGoBackButton()
    {
        if (_customerIsMember)
        {
            _customerIsMember = false;
            _step = 0;
            NavigationManager.NavigateTo("/Order -in -items");
            return;
        }

        _step--;
    }

    //implements placing an order 
    private void handleOrderPlace()
    {
        try
        {
            if (!_customerIsMember)
            {
                CustomerService.AddCustomer(_customer);
            }


            Order order = new()
                {
                    CustomerID = _customer.CustomerID,
                    CustomerName = _customer.CustomerName,
                    CustomerPhoneNum = _customer.CustomerPhoneNum,
                    EmployeeName = _globalState.CurrentUser.Password,
                    OrderTotalAmount = Math.Round(_totalAmount, 2),
                    OrderItems = _globalState.OrderItems,
                    DiscountAmount = Math.Round(_discountAmount, 2),
                };


            OrderService.PlaceOrder(order);

            Snackbar.Add("The order has been placed successfully. Thank You", Severity.Success);

            _globalState.OrderItems = new List<OrderItemModel>();

            NavigationManager.NavigateTo("/Order-in-items");

        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
    }
}
