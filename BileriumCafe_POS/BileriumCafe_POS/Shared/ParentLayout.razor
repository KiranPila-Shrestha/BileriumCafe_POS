@inherits LayoutComponentBase
@inject UserServices UserServices

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <CascadingValue Value="this">
        <CascadingValue Value="_globalState">
            @Body
        </CascadingValue>
    </CascadingValue>
</MudLayout>


@code {
    private GlobalState _globalState { get; set; } = new GlobalState();
}