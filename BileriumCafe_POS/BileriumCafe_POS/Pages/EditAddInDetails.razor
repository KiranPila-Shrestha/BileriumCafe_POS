@page "/add-in-items/{addInsID}"
@inject NavigationManager NavigationManager
@inject AddItemService AddItemService
@inject ISnackbar Snackbar


<div style="padding-top:10px; margin-left:30px; padding-bottom:10px">
    <MudText Class="pt-4" Typo="Typo.h3">Update Coffee</MudText>
</div>

<div style="padding-left:30px;">
    <MudGrid>
        <MudItem xs="12" sm="7">
            <MudCard>
                <MudCardContent>
                    <MudTextField Label="Product Name" @bind-Value="_addIns.ProductName" />
                    <MudTextField Label="Price" InputType="@InputType.Number" Class="mt-3" @bind-Value="_addIns.Price" />
                    <MudTextField Label="Password" T="string" InputType="InputType.Password" Class="mt-3" @bind-Value="_currentPassword" />
                </MudCardContent>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
                }



                <MudCardActions>

                    <MudButton OnClick="BackToAddInsListPage" ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Error">Back</MudButton>

                    <MudButton OnClick="HandleAddInsUpdate" Variant="Variant.Outlined" Color="Color.Primary" Class="ml-auto">Update Coffee</MudButton>

                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</div>

@code {

    [Parameter]
    public string addInsID { get; set; }

    [CascadingParameter]
    private GlobalState _globalState { get; set; }

    private string _currentPassword { get; set; }

    private AddIn _addIns { get; set; }

    private string _errorMessage { get; set; } = "";


    protected override void OnInitialized()
    {
        _addIns = AddItemService.GetAddInsByID(addInsID);
    }


    private void HandleAddInsUpdate()
    {
        try
        {
            if (String.IsNullOrEmpty(_currentPassword))
            {
                _errorMessage = "Please enter your Password";
                return;
            }

            // COffee Name is empty
            if (String.IsNullOrEmpty(_addIns.ProductName))
            {
                _errorMessage = "Please enter Coffee Name";
                return;
            }

            // Price checking
            if (_addIns.Price <= 0)
            {
                _errorMessage = "Please enter a valid price";
                return;
            }

            // Checking password
            if (_currentPassword != _globalState.CurrentUser.Role)
               
            {
                _errorMessage = "Invalid password";
                return;
            }


            _errorMessage = "";

            Snackbar.Add("AddIns Details updated sucessfully", Severity.Success);

            AddItemService.UpdateAddInsDetails(_addIns);

            BackToAddInsListPage();

        }

        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    protected void BackToAddInsListPage()
    {
        NavigationManager.NavigateTo("/add-in-items");
    }
}