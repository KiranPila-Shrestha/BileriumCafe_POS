@page "/Order-in-items"
@inject CoffeeService CoffeeService
@inject OrderItemService OrderItemService
@inject AddItemService AddItemService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<style>
    .custom-alert {
        background-color: #2196f3; /* Use your preferred background color */
        color: #fff; /* Text color */
        border-radius: 7px;
        padding: 10px;
        margin-top: 10px;
      
    }

    .custom-h6 {
        font-size: 1.25rem; 
        font-weight: bold; 
    }

.custom-th {
    padding: 10px; /* Adjust the padding as needed */
    border: 2px solid #2980b9;
    font-weight: bolder; /* Make the text bold */
    font-size: 19px; /* Adjust the font size as needed */
    font-family: 'Arial', sans-serif; /* Border color for the bottom of each header cell */
    
}


</style>

@if (Elements.Count() == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="custom-alert">The cart is currently Empty. Please add some items!!</MudAlert>
}
else
{
    <MudTable Items="@Elements"
              Dense="@dense"
              Hover="@hover"
              Bordered="@bordered"
              Striped="@striped">

        <ToolBarContent>
            <MudText Typo="Typo.h6" Class="custom-h6">Order Items List</MudText>
            <MudSpacer />
            <MudText Typo="Typo.subtitle1" Class="custom-h6">Total Amount: <b>Rs.@Math.Round(_totalAmount, 2)</b></MudText>
        </ToolBarContent>


        <HeaderContent>
            <MudTh class="custom-th">Item Name</MudTh>
            <MudTh class="custom-th">Item Type</MudTh>
            <MudTh class="custom-th">Price</MudTh>
            <MudTh class="custom-th">Quantity</MudTh>
            <MudTh class="custom-th">Total</MudTh>
            <MudTh class="custom-th">Action</MudTh>
        </HeaderContent>


        <RowTemplate>
            <MudTd DataLabel="CoffeeType">@context.ItemName</MudTd>
            <MudTd DataLabel="Item Type">@context.ItemType</MudTd>
            <MudTd DataLabel="Price">Rs.@context.Price</MudTd>

            <MudTd DataLabel="Quantity">

                <MudIconButton Icon="@Icons.Material.Filled.Remove" aria-label="subtract" OnClick="@(() => ManageQuantity(context.OrderItemID, "subtract"))"></MudIconButton>

                <span>
                    @context.Quantity
                </span>

                <MudIconButton Icon="@Icons.Material.Filled.Add" aria-label="add" OnClick="@(() => ManageQuantity(context.OrderItemID, "add"))"></MudIconButton>


            </MudTd>

            <MudTd DataLabel="Price">Rs.@Math.Round(context.TotalPrice, 2)</MudTd>
            <MudTd DataLabel="Action">
                <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.Delete" aria-label="delete" OnClick="@(() => handleDeleteCartItem(context.OrderItemID))"></MudIconButton>
            </MudTd>




        </RowTemplate>




    </MudTable>

    <div class="mt-5">
        <MudButton Variant="Variant.Outlined" Class="mr-5"  Color="Color.Primary" OnClick="clearCart">Clear Cart</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => NavigationManager.NavigateTo("/checkoutpage"))">Checkout</MudButton> 
    </div> 
}


@code {
    [CascadingParameter]
    private GlobalState _globalState { set; get; }
    private Coffee _coffee { set; get; }
    private double _totalAmount { set; get; } = 0;
    private IEnumerable<OrderItemModel> Elements = new List<OrderItemModel>();

     private void clearCart()
     {
         _globalState.OrderItems.Clear();
         Snackbar.Add("Cart is clear", Severity.Success);
     }

    private void handleDeleteCartItem(Guid orderItemID)
    {
        OrderItemService.DeleteItemInOrderItemsList(_globalState.OrderItems, orderItemID);
        _totalAmount = OrderItemService.CalculateTotalAmount(Elements);
        Snackbar.Add($"The Item is cleared.", Severity.Success);
    }

    private void ManageQuantity(Guid orderItemID, string action)
    {
        OrderItemService.ManageQuantityOfOrderItem(_globalState.OrderItems, orderItemID, action);
        _totalAmount = OrderItemService.CalculateTotalAmount(Elements);

    }

     protected override void OnInitialized()
     {
        Elements = _globalState.OrderItems;
       _totalAmount = OrderItemService.CalculateTotalAmount(Elements);

    }

    private bool dense = true;
    private bool hover = true;
    private bool striped = true;
    private bool bordered = true;

}
